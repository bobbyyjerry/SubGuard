# Copy this file to ".env" and fill in real values.
# .env is listed in .gitignore, so your secrets never reach GitHub.

# --- Flask ---
FLASK_DEBUG=1
FLASK_CONFIG=development
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (optional) ---
# Leave unset to use instance/subguard.db
# DATABASE_URL=sqlite:///D:/path/to/subguard.db

# --- Email reminders ---
# MAIL_TRANSPORT=smtp
# MAIL_SERVER=smtp.example.com
# MAIL_DEFAULT_SENDER="SubGuard <you@example.com>"
# MAIL_SECURITY=starttls
# MAIL_PORT=587
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-smtp-password
# REMINDER_DAYS=3
# To use the Brevo HTTPS API, set MAIL_TRANSPORT=brevo and set the verified MAIL_DEFAULT_SENDER.
# BREVO_API_KEY=

# --- Reminders on a host with no scheduler (optional) ---
# Lets a daily GitHub Actions job send the reminders. Leave unset to keep it off.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# REMINDER_TRIGGER_TOKEN=
