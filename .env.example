# Copy this file to ".env" and fill in real values.
# .env is listed in .gitignore, so your secrets never reach GitHub.

# --- Flask ---
FLASK_DEBUG=1
FLASK_CONFIG=development
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (optional) ---
# Leave unset to use instance/subguard.db
# DATABASE_URL=sqlite:///D:/path/to/subguard.db

# --- Email (used from Day 8) ---
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-character-app-password
# MAIL_DEFAULT_SENDER=SubGuard <you@gmail.com>
